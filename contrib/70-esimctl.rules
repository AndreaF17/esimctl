# Give the logged-in user access to the modem's MBIM control port (eSIM
# management), its AT port (GNSS on/off) and its NMEA port (GNSS fixes).
SUBSYSTEM=="wwan", KERNEL=="wwan[0-9]*mbim[0-9]*", TAG+="uaccess"
SUBSYSTEM=="wwan", KERNEL=="wwan[0-9]*at[0-9]*", TAG+="uaccess"
SUBSYSTEM=="gnss", KERNEL=="gnss[0-9]*", TAG+="uaccess"
